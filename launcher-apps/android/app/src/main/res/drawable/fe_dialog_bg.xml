<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogs in the app theme: dark panel, cyan edge -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="20dp">
    <shape android:shape="rectangle">
        <solid android:color="#F707100F"/>
        <stroke android:width="1dp" android:color="#AA00E5FF"/>
        <corners android:radius="14dp"/>
        <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp"/>
    </shape>
</inset>
