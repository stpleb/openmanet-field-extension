#!/bin/sh /etc/rc.common
# Field Extensions web UI and API on the node's own LAN/mesh address, port 8787.
# (openmanetd owns 8080/8081 on OpenMANET 1.8.) Writes need the node login.
START=99
STOP=10
USE_PROCD=1

start_service() {
	local addr
	addr="$(uci -q get network.ahwlan.ipaddr)"
	[ -n "$addr" ] || addr="$(uci -q get network.lan.ipaddr)"
	addr="${addr%%/*}"
	[ -n "$addr" ] || addr=127.0.0.1
	procd_open_instance
	procd_set_param command /usr/bin/python3 -m field_extension.server --host "$addr" --port 8787 --enable-writes
	procd_set_param env PYTHONPATH=/opt/field-extensions
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Status LED (R27 G22 B26 unless node.conf sets LED_RED/LED_GREEN/LED_BLUE).
	procd_open_instance led
	procd_set_param command /usr/bin/python3 -m field_extension.led_driver
	procd_set_param env PYTHONPATH=/opt/field-extensions
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Phone internet choice (auto / cellular), re-checked every 15 s like RC1.
	procd_open_instance eud
	procd_set_param command /usr/bin/python3 -m field_extension.eud watch
	procd_set_param env PYTHONPATH=/opt/field-extensions
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# LoRa fallback and radio control (Meshtastic USB radio).
	procd_open_instance lora
	procd_set_param command /usr/bin/python3 -m field_extension.lora
	procd_set_param env PYTHONPATH=/opt/field-extensions
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Self-recovery (HaLow watchdog, rate latch, link check, reboot log).
	procd_open_instance recovery
	procd_set_param command /usr/bin/python3 -m field_extension.recovery
	procd_set_param env PYTHONPATH=/opt/field-extensions
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Put phone DHCP back to normal if cellular mode was active.
	PYTHONPATH=/opt/field-extensions /usr/bin/python3 -m field_extension.eud restore
	# A planned stop (reboot, shutdown, update): the reboot log counts it as clean.
	PYTHONPATH=/opt/field-extensions /usr/bin/python3 -c 'from field_extension.recovery import mark_clean; mark_clean("shutdown or restart", overwrite=False)' 2>/dev/null
}

service_triggers() {
	procd_add_reload_interface_trigger ahwlan
}
